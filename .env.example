# Copy to .env and replace placeholders for your environment.
# Host paths and container paths are configured separately.
DICOM_IMAGE='dicom-proxy:latest'
DICOM_BUILD_CONTEXT='.'
DICOM_CONTAINER_NAME='dicom-proxy-service'
DICOM_HTTP_PORT_MAPPING='80:80'
DICOM_SCP_PORT_MAPPING='11112:11112'
CERTS_DIR='./certs'
CERTS_LEGACY_CONTAINER_DIR='/app/legacy-certs'
CERTS_CONTAINER_DIR='/app/certs'
ES_CA_PATH='./certs/elasticsearch-ca.crt'
ES_CA_CONTAINER_PATH='/app/certs/ca.crt'
DICOM_SCP_BASE_DIR='./dicom-temp'
DICOM_SCP_CONTAINER_DIR='/app/dicom-temp'
JAVA_OPTS='-Dhttps.protocols=TLSv1.2,TLSv1.3 -Djdk.tls.client.protocols=TLSv1.2,TLSv1.3'
BASE_URL='https://pacs.example.com:9443'
CERTIFICATE_PATH='/app/certs/server.pem'
PRIVATE_KEY_PATH='/app/certs/server.key'
CERTIFICATE_PASSWORD='your_certificate_password'
CLIENT_CA_PATH='/app/certs/client-ca.crt'
CAPATH='/app/certs/ca.crt'
MAX_DICOM_REQUEST='10'
DICOM_FORWARD_SPOOL_DIR='/app/dicom-temp/forward-spool'
DICOM_FORWARD_MAX_SPOOL_SIZE='5GB'
DICOM_FORWARD_MIN_FREE_DISK_SPACE='5GB'
DICOM_FORWARD_MAX_METADATA_SCAN_SIZE='8MB'
DICOM_FORWARD_MAX_STOW_RESPONSE_SIZE='1MB'
DICOM_FORWARD_MAX_CONCURRENT_SPOOLS='10'
DICOM_FORWARD_STALE_SPOOL_RETENTION='24h'
DICOM_SCP_ENABLED='false'
DICOM_SCP_AET='DICOM_PROXY'
DICOM_SCP_ALLOWED_AETS='EXAMPLE_SCU'
DICOM_SCP_MAX_THREADS='10'
DICOM_SCP_PORT='11112'
DICOM_SCP_TLS_ENABLED='false'
DICOM_SCP_MTLS_ENABLED='false'
DISCORD_WEBHOOK_URL='https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN'
DOCKER_POSTGRESQL_DATASOURCE_URL='jdbc:postgresql://host.docker.internal:5432/dicom'
POSTGRESQL_DATASOURCE_USERNAME='postgres'
POSTGRESQL_DATASOURCE_PASSWORD='your_postgres_password'
SPRING_ELASTICSEARCH_URIS='https://host.docker.internal:9200'
SPRING_ELASTICSEARCH_USERNAME='elastic'
SPRING_ELASTICSEARCH_PASSWORD='your_elasticsearch_password'
GOOGLE_AI_API_KEY='your_google_ai_api_key'
GOOGLE_AI_EMBEDDING_MODEL='gemini-embedding-2'
GOOGLE_AI_OUTPUT_DIMENSIONALITY='768'
GOOGLE_AI_CHAT_MODEL='gemini-3.5-flash-lite'
DOCKER_HOST_MAPPING='host.docker.internal:host-gateway'
PACS_HOST_MAPPING='pacs.example.com:host-gateway'

# Local application settings (outside Docker Compose)
POSTGRESQL_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dicom
DICOM_FORWARD_JOB_RETENTION=24h
DICOM_FORWARD_JOB_MAX_ENTRIES=10000
DICOM_FORWARD_ADMISSION_ENABLED=true
DICOM_FORWARD_MAX_CONCURRENT_UPLOADS=10
